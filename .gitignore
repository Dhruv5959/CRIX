# Environment / secrets
.env
*.env
!.env.example

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Databases (local dev)
*.db
*.sqlite3

# Node / frontend
node_modules/
dist/
.vite/
*.local

# Model artifacts (large, regenerated by scripts)
backend/artifacts/*.joblib
backend/artifacts/*.json
!backend/artifacts/.gitkeep

# Dev email outbox: password-reset messages contain single-use tokens. Never commit.
backend/artifacts/outbox/
backend/artifacts/*.eml

# Logs
*.log
# One-off local pytest transcripts can include request/session diagnostics.
backend/*_run.txt

# Local agent/tooling runtime and vendored third-party checkouts
.opencode/
.claude/
.playwright/
awesome-design-md/

# Design / visual-verification artifacts (local only, regenerated)
.design-checks/
.playwright-cli/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
