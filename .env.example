# CRIX environment configuration (example). Copy to `.env` — the file goes at the
# PROJECT ROOT, next to this file. NEVER commit a real `.env`.
#
# Both locations are read (project root wins if both exist):
#     C:\...\major project\.env        <- documented, matches this example
#     C:\...\major project\backend\.env
# Values are re-read on startup, so RESTART the API after editing.

# --- Core ---
CRIX_ENV=development
CRIX_DATABASE_URL=sqlite:///./crix.db
# Prod example:
# CRIX_DATABASE_URL=postgresql+psycopg://crix:password@localhost:5432/crix

# --- Auth secrets (generate strong random values) ---
# python -c "import secrets; print(secrets.token_urlsafe(64))"
CRIX_JWT_SECRET=dev-only-insecure-change-me
CRIX_ACCESS_TOKEN_EXPIRE_MINUTES=15
CRIX_REFRESH_TOKEN_EXPIRE_DAYS=7
CRIX_BCRYPT_ROUNDS=12

# --- CORS (comma-separated OR a JSON array; no wildcard in prod) ---
CRIX_CORS_ORIGINS=http://localhost:5173

# --- HIBP (real breach checking) ---
# Used for the keyless Pwned Passwords RANGE check (always available), and for the
# email breach lookup when CRIX_BREACH_EMAIL_PROVIDER resolves to "hibp".
CRIX_HIBP_API_KEY=

# --- Email breach lookup provider (XposedOrNot / HIBP) ---
#   auto         -> HIBP when CRIX_HIBP_API_KEY is set, else the free
#                   XposedOrNot community API (no key, no signup)  [default]
#   xposedornot  -> always the free XposedOrNot API
#   hibp         -> always HIBP (also reports which data classes leaked)
# XposedOrNot needs NO API key. The provider that actually answers is shown in
# the app and stored on every breach event, so nothing is ambiguous.
CRIX_BREACH_EMAIL_PROVIDER=auto
# XposedOrNot's published free-tier limits for GET /v1/check-email/{email}:
# 2 requests/second and 25/hour per IP. CRIX throttles its own outbound calls to
# these numbers and backs off after an HTTP 429. Raising them beyond your plan's
# allowance may get the IP blocked, so only change them if you have a paid tier.
CRIX_XPOSEDORNOT_REQUESTS_PER_SECOND=2
CRIX_XPOSEDORNOT_REQUESTS_PER_HOUR=25
CRIX_XPOSEDORNOT_TIMEOUT_SECONDS=10

# --- Rate limiting ---
CRIX_LOGIN_RATE_LIMIT_PER_MINUTE=5
CRIX_PASSWORD_CHECK_RATE_LIMIT_PER_MINUTE=30
# Inbound cap for POST /api/signals/breach, so one client cannot exhaust the
# provider's small free-tier quota.
CRIX_BREACH_CHECK_RATE_LIMIT_PER_MINUTE=10
# Unauthenticated endpoints that are expensive (bcrypt) or send email.
CRIX_REGISTER_RATE_LIMIT_PER_MINUTE=20
CRIX_PASSWORD_RESET_RATE_LIMIT_PER_MINUTE=10
CRIX_INVITE_ACCEPT_RATE_LIMIT_PER_MINUTE=20

# --- Outbound links & trusted proxy ---
# Base URL the backend builds emailed links from (password reset, invitation).
# MUST be the real public URL in production (startup fails on localhost ones).
CRIX_PUBLIC_BASE_URL=http://localhost:5173
# Set True ONLY when the app actually sits behind a trusted reverse proxy that
# sets X-Forwarded-For. Otherwise a client could spoof the header and rotate
# rate-limit buckets.
CRIX_TRUST_PROXY_HEADERS=False

# --- SMTP (production email transport) ---
# Dev leaves these blank: messages are written to backend/artifacts/outbox/.
# PRODUCTION REQUIRES CRIX_SMTP_HOST (startup fails without it) so password
# reset and invitations actually work. CRIX_SMTP_PASSWORD must never be committed.
CRIX_SMTP_HOST=
CRIX_SMTP_PORT=587
CRIX_SMTP_USER=
CRIX_SMTP_PASSWORD=
CRIX_EMAIL_FROM=no-reply@crix.local
CRIX_SMTP_START_TLS=True

# --- Risk model (Phase 6b dependency exposure) ---
# The DependencyExposure term adds the org dependency graph's documented blast
# radius to the contextual score (docs/RISK_MODEL.md §1.3, version risk-2.1).
# Default ON. Set to False to ABLATE the term (the evaluation's "CRIX without
# the dependency" ablation); every score then records status=DISABLED, so an
# ablated run is never mistaken for a run that found no exposure.
CRIX_RISK_DEPENDENCY_EXPOSURE_ENABLED=True

# --- Live account connections (official OAuth 2.0 / OIDC) — FROZEN ---
# CRIX-SMB does not connect to third-party providers. The flag below defaults to
# OFF *in code*; when it is off the /api/oauth surface does not exist (404) and
# no connector appears in the UI or the demo. These platforms do not expose
# breach/MFA/connected-app data to third-party apps, so a connection proves
# nothing about security. Instagram was removed entirely (no official API for
# personal accounts since 2024-12-04).
CRIX_OAUTH_CONNECTORS_ENABLED=False

# Only used if you explicitly re-enable connectors above. Leave a provider's
# id/secret blank -> it reports NOT_CONFIGURED and the UI shows the connector as
# unavailable. Register the redirect URI shown below EXACTLY in the console.
#
#   Google    : https://developers.google.com/identity/protocols/oauth2/web-server
#   LinkedIn  : https://learn.microsoft.com/linkedin/shared/authentication/authentication
#
CRIX_GOOGLE_CLIENT_ID=
CRIX_GOOGLE_CLIENT_SECRET=
CRIX_LINKEDIN_CLIENT_ID=
CRIX_LINKEDIN_CLIENT_SECRET=

# Where the provider sends the browser back after authorizing.
CRIX_OAUTH_REDIRECT_BASE=http://127.0.0.1:8000/api/oauth
# Where CRIX sends the browser after the callback is handled.
CRIX_OAUTH_FRONTEND_REDIRECT=http://localhost:5173/connections

# Fernet key for encrypting OAuth refresh/access tokens at rest.
# REQUIRED in production. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# In dev, if blank, a key is derived from CRIX_JWT_SECRET (never do this in prod).
CRIX_TOKEN_ENCRYPTION_KEY=

# Clearly-labeled FIXTURE connectors for local demos (disabled in production).
CRIX_ALLOW_FIXTURE_CONNECTORS=True

# --- Frontend (Vite) ---
# VITE_API_BASE_URL=http://localhost:8000